# 统一行尾，避免 Windows / macOS / Linux 混合协作时产生「整个文件都变了」的假 diff。
# 仓库内统一存 LF，检出时按平台自动转换。
* text=auto eol=lf

# 明确指定必须是 LF 的文件（shell 脚本用 CRLF 会直接执行失败）
*.sh    text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.json  text eol=lf

# Windows 批处理必须是 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制文件不做转换，也不在 PR 里显示 diff
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.docx  binary
*.xlsx  binary
*.pptx  binary
*.db    binary
*.sqlite3 binary

# 锁文件在 PR 里折叠显示，减少审核噪音
package-lock.json  linguist-generated=true -diff
poetry.lock        linguist-generated=true -diff
uv.lock            linguist-generated=true -diff
